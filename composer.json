{
    "name": "bmhv/therapists",
    "description": "TN Therapists",
    "license": "BSD-3-Clause",
    "type": "project",
    "keywords": [
        "ghostwriter",
        "bmhv",
        "black-mental-health-village",
        "mental-health",
        "therapists",
        "black-lives-matter"
    ],
    "authors": [
        {
            "name": "Nathanael Esayeas",
            "email": "nathanael.esayeas@protonmail.com",
            "homepage": "https://github.com/ghostwriter",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/bmhv/therapists",
    "support": {
        "issues": "https://github.com/bmhv/therapists/issues",
        "source": "https://github.com/bmhv/therapists",
        "rss": "https://github.com/bmhv/therapists/releases.atom",
        "security": "https://github.com/bmhv/therapists/security/advisories/new"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/ghostwriter"
        }
    ],
    "_comment": [
        "#BlackLivesMatter",
        "#FreePalestine",
        "#StandWithIran",
        "#StandWithUkraine",
        "#StopGenocide"
    ],
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ghostwriter/config": "^2.1.3",
        "ghostwriter/console": "^0.2.3",
        "ghostwriter/container": "^7.0.2",
        "ghostwriter/filesystem": "^0.2.1",
        "ghostwriter/http": "^0.2.1",
        "ghostwriter/json": "^3.0.3",
        "guzzlehttp/guzzle": "^7.13.1",
        "illuminate/collections": "^13.18.0",
        "illuminate/contracts": "^13.18.0",
        "illuminate/database": "^13.18.0",
        "illuminate/events": "^13.18.0",
        "laminas/laminas-diactoros": "^3.8.0",
        "laminas/laminas-escaper": "^2.18.0",
        "laminas/laminas-httphandlerrunner": "^2.13.0",
        "laminas/laminas-stratigility": "^4.3.1",
        "mezzio/mezzio": "^3.28.1",
        "mezzio/mezzio-fastroute": "^3.14.0",
        "mezzio/mezzio-platesrenderer": "^2.14.0",
        "phpoffice/phpspreadsheet": "^5.8.0",
        "symfony/css-selector": "^8.1.0",
        "symfony/dom-crawler": "^8.1.1",
        "vlucas/valitron": "^1.4.11"
    },
    "require-dev": {
        "ext-xdebug": "*",
        "ghostwriter/coding-standard": "dev-main",
        "mockery/mockery": "^1.6.12",
        "phpunit/phpunit": "^13.2.0",
        "symfony/var-dumper": "^8.1.0",
        "boundwize/structarmed": "^0.14.6"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "BlackMentalHealthVillage\\Therapists\\": "src/",
            "Database\\": "database/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "": "tests/Fixture/",
            "Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "/tests/"
        ]
    },
    "bin": [
        "bin/console"
    ],
    "config": {
        "allow-plugins": {
            "ghostwriter/coding-standard": true
        },
        "classmap-authoritative": false,
        "discard-changes": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.4.999"
        },
        "preferred-install": "dist",
        "prepend-autoloader": true,
        "process-timeout": 5000,
        "sort-packages": true,
        "use-parent-dir": false
    },
    "extra": {
        "ghostwriter": {
            "container": {
                "provider": [
                    "BlackMentalHealthVillage\\Therapists\\Container\\TherapistsProvider"
                ]
            }
        },
        "thanks": {
            "name": "bmhv/therapists",
            "url": "https://github.com/bmhv/therapists"
        }
    },
    "scripts": {
        "cache:clear": "rm -rf ./.cache/*",
        "check": [
            "@cache:clear",
            "vendor/bin/composer validate",
            "@test"
        ],
        "docker": [
            "@docker:build",
            "@docker:run"
        ],
        "docker:build": "docker buildx build --pull --tag workspace .",
        "docker:run": "docker run -v $(PWD):/github/workspace -w=/github/workspace -e GITHUB_DEBUG=1 -e GITHUB_WORKSPACE=/github/workspace -e GITHUB_TOKEN=github-token -e SIGNING_SECRET_KEY=secret-key workspace",
        "git:submodule:update": "git submodule update --depth=1 --init --recursive --recommend-shallow --remote",
        "infection": [
            "@xdebug",
            "vendor/bin/infection --min-covered-msi=0 --min-msi=0 --show-mutations --threads=max"
        ],
        "phpbench": "vendor/bin/phpbench run --report='extends:aggregate,cols:[benchmark,subject,revs,its,mem_peak,mode,rstdev]' --time-unit=milliseconds ./tests/Benchmark",
        "phpunit": [
            "@xdebug",
            "vendor/bin/phpunit --do-not-cache-result --colors=always"
        ],
        "test": [
            "@phpunit",
            "@infection"
        ],
        "unused": "vendor/bin/composer-unused --no-interaction --ansi",
        "xdebug": "@putenv XDEBUG_MODE=coverage"
    }
}
